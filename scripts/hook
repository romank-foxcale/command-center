#!/usr/bin/env bash
# Run a rule hook (scripts/rule_hooks.py) with the first Python that works. On native Windows
# python3 is often the Microsoft Store stub, so it is probed rather than trusted.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for candidate in python3 python "py -3"; do
  if $candidate -c '' >/dev/null 2>&1; then
    exec $candidate "$here/rule_hooks.py" "$@"
  fi
done
# Exit 1 shows the warning without blocking the tool call (exit 2 would block it).
printf '%s\n' "rule hooks: no working Python (tried python3, python, py -3); hard rules are NOT enforced" >&2
exit 1
